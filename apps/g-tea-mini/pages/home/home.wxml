      <t-grid-item t-class-image="image" text="标题文字" image="{{img2}}" />
      <t-grid-item t-class-image="image" text="标题文字" image="{{img3}}" />
      <t-grid-item t-class-image="image" text="最多五个字" image="{{img1}}" />
